{
  "name": "smartcampus-server",
  "version": "1.0.0",
  "description": "Backend server for SmartCampus Attendance Management System",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "setup": "ts-node scripts/setup.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prestart": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "attendance",
    "management",
    "system",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.8.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.3.0",
    "csv-stringify": "^6.2.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "joi": "^17.9.1",
    "multer": "^1.4.5-lts.1",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.7",
    "@types/node": "^18.15.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.54.1",
    "@typescript-eslint/parser": "^5.54.1",
    "eslint": "^8.35.0",
    "jest": "^29.7.0",
    "rimraf": "^4.4.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.3",
    "ts-node-dev": "^2.0.0"
  }
}
