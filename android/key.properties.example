# Copy this file to android/key.properties and fill in your real values.
# Keep the real key.properties file out of git.
#
# Recommended:
# - Store the .jks/.keystore file outside this repository.
# - Use an absolute path for storeFile.
# - Keep a second encrypted backup of the keystore in a password manager or secure vault.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/your/smartcampus-upload-keystore.jks
