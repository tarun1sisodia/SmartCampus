# ###########################################################
# SmartCampus Root Gitignore
# ###########################################################

# OS Files
# -----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Files
# -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Node / Web Common
# -----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
.prettiercache

# Environment & Secrets
# -----------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Python (if any)
# -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Flutter / Dart (General)
# -----------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/

# Miscellaneous
# -----------------------------------------------------------
tmp/
temp/
out/
dist/
coverage/
logs/
*.log
