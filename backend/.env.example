PORT=5000
NODE_ENV=development

# Database Configs
MONGO_URI=mongodb://localhost:27017/smartcampus
REDIS_URL=redis://localhost:6379

# JWT Secrets — REQUIRED. Generate with: openssl rand -hex 48
# The server refuses to boot in production if these are missing/weak.
JWT_ACCESS_SECRET=replace-with-48-byte-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-48-byte-random-hex
JWT_ACCESS_TTL=15m

# QR attendance signing secret — REQUIRED. Generate with: openssl rand -hex 32
QR_SECRET_KEY=replace-with-32-byte-random-hex

# Optional campus geofence for QR attendance (enforced only when all three set)
QR_GEOFENCE_LAT=
QR_GEOFENCE_LON=
QR_GEOFENCE_RADIUS_METERS=

# External S3 (backups)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_BACKUP_BUCKET=smartcampus-backups

# Sentry
SENTRY_DSN=

# CORS — comma-separated list of allowed web origins
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# SMTP (email worker)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SmartCampus
SMTP_FROM_EMAIL=

# Firebase Cloud Messaging (push)
FCM_SERVICE_ACCOUNT_PATH=

# Cloudinary (images)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeding Variables (change before running seed in any shared environment)
SUPER_ADMIN_EMAIL=superadmin@smartcampus.com
SUPER_ADMIN_PASSWORD=ChangeMe-Immediately-123

# Limits
CSV_MAX_ROWS=5000
