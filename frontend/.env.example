# API base URL. Android emulator typically uses http://10.0.2.2:5000/api/v1.
# Set this via a .env file or --dart-define=API_BASE_URL=...
API_BASE_URL=http://10.0.2.2:5000/api/v1
BACKEND_BASE_URL=http://10.0.2.2:5000/api/v1
SOCKET_URL=http://10.0.2.2:5000

# Optional
SENTRY_DSN=
ENABLE_BIOMETRIC=true
ENABLE_PUSH_NOTIFICATIONS=true
