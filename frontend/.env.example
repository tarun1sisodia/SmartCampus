# SmartCampus Teacher App — Environment
# Copy to .env and adjust per environment.
# API base URL must be HTTPS in production (Android blocks cleartext).
BACKEND_BASE_URL=http://10.0.2.2:5000/api/v1
SOCKET_URL=http://10.0.2.2:5000
SENTRY_DSN=

# Build-time overrides (passed via --dart-define, see lib/env/env_config.dart):
#   --dart-define=API_BASE_URL=https://api.smartcampus.example/api/v1
#   --dart-define=ENABLE_BIOMETRIC=true
#   --dart-define=ENABLE_PUSH_NOTIFICATIONS=true
#   --dart-define=SENTRY_DSN=
